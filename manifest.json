{
  "manifest_version": 3,
  "name": "My Stock 自選股",
  "version": "1.2.0",
  "description": "台股自選清單：即時報價與走勢、多組分組，記錄持有張數與均價，自動計算總資產與損益。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "My Stock 自選股",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://mis.twse.com.tw/*",
    "https://tw.stock.yahoo.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://openapi.twse.com.tw/*",
    "https://www.tpex.org.tw/*"
  ]
}
